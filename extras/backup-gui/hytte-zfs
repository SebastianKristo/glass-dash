#!/usr/bin/env python3
# Hytte Backup – ZFS-hjelper på Proxmox-verten.
# Leser forespørsler fra <mountpoint>/.hytte/req (skrevet av backup-containeren), tar/rydder snapshots
# og skriver svar til .hytte/res, pluss oversikten snapshots.json og meta.json.
# Rører bare snapshots som heter «hytte-…» på datasettet i /etc/hytte-zfs.conf.
import json, os, re, subprocess, sys, time, glob

conf = {}
for line in open('/etc/hytte-zfs.conf'):
    if '=' in line and not line.startswith('#'):
        k, v = line.strip().split('=', 1); conf[k] = v
DS = conf['DATASET']
MNT = subprocess.run(['zfs', 'get', '-H', '-o', 'value', 'mountpoint', DS], capture_output=True, text=True).stdout.strip()
HY = os.path.join(MNT, '.hytte'); REQ = os.path.join(HY, 'req'); RES = os.path.join(HY, 'res')
os.makedirs(REQ, exist_ok=True); os.makedirs(RES, exist_ok=True)
NAME = re.compile(r'^hytte-[A-Za-z0-9_.:-]{1,120}$')

def zfs(*a):
    r = subprocess.run(['zfs', *a], capture_output=True, text=True)
    if r.returncode: raise RuntimeError(r.stderr.strip() or 'zfs feilet')
    return r.stdout

def write(path, obj):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f: json.dump(obj, f)
    os.chmod(tmp, 0o644); os.replace(tmp, path)

def snaps():
    out = zfs('list', '-H', '-p', '-t', 'snapshot', '-o', 'name,creation,written', '-d', '1', DS)
    res = []
    for l in out.splitlines():
        n, c, w = l.split('\t'); res.append({'name': n, 'creation': int(c), 'written': int(w) if w.isdigit() else None})
    return res

def handle(req):
    op = req.get('op')
    if op == 'snapshot':
        n = req.get('name', '')
        if not NAME.match(n): raise ValueError('Ugyldig snapshot-navn')
        zfs('snapshot', f'{DS}@{n}'); return {'name': f'{DS}@{n}'}
    if op == 'prune':
        now, removed = time.time(), []
        all_ = snaps()
        for k in req.get('keep', []):
            pre, days = str(k.get('prefix', '')), int(k.get('days', 30))
            if not pre.startswith('hytte-'): continue
            mine = sorted([s for s in all_ if s['name'].split('@')[1].startswith(pre)], key=lambda s: s['creation'])
            for s in mine[:-1]:  # behold alltid den nyeste
                if now - s['creation'] > days * 86400:
                    zfs('destroy', s['name']); removed.append(s['name'])
        return {'removed': removed}
    raise ValueError('Ukjent operasjon')

try: zv = open('/sys/module/zfs/version').read().strip().split('-')[0]
except Exception: zv = None
for f in sorted(glob.glob(os.path.join(REQ, '*.json'))):
    rid = os.path.basename(f)[:-5]
    try:
        req = json.load(open(f)); out = {'ok': True, **handle(req)}
    except Exception as e:
        out = {'ok': False, 'error': str(e)}
    try: os.remove(f)
    except FileNotFoundError: pass
    write(os.path.join(RES, rid + '.json'), out)
# Gamle svar som aldri ble hentet
for f in glob.glob(os.path.join(RES, '*.json')):
    if time.time() - os.path.getmtime(f) > 3600: os.remove(f)
write(os.path.join(HY, 'snapshots.json'), snaps())
write(os.path.join(HY, 'meta.json'), {'dataset': DS, 'zfsVersion': zv, 't': int(time.time())})
